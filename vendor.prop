# Display
ro.surface_flinger.set_display_power_timer_ms=200
ro.surface_flinger.set_idle_timer_ms=1000
ro.surface_flinger.set_touch_timer_ms=1000
ro.surface_flinger.use_content_detection_for_refresh_rate=true

# Fingerprint
ro.vendor.fingerprint.type=side
ro.vendor.fingerprint.supports_gestures=false
ro.vendor.fingerprint.sensor_location=1080|820|350|local:4633128672291735932

# NFC
ro.camera.notify_nfc=1
ro.vendor.nfc.feature.chipname=NXP_SN100U
ro.vendor.nfc.info.antpos=16
ro.vendor.nfc.info.antposX=25.4
ro.vendor.nfc.info.antposY=35
ro.vendor.nfc.info.deviceFoldable=false
ro.vendor.nfc.info.deviceHeight=165.4
ro.vendor.nfc.info.deviceWidth=76.9
ro.vendor.nfc.support.advancedsetting=false
ro.vendor.nfc.support.autoselect=true
ro.vendor.nfc.support.defaultaid=true
ro.vendor.nfc.support.ese=false
ro.vendor.nfc.support.nonaid=true
ro.vendor.nfc.support.othercategory=true
ro.vendor.nfc.support.uicc=true
